{
  "name": "dsh-ssh-workspace",
  "version": "0.1.0",
  "description": "Mixed local and SSH workspace execution bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./sandbox": {
      "types": "./lib/sandbox.d.ts",
      "default": "./lib/sandbox.js"
    },
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./local-pwsh-subprocess": {
      "types": "./lib/local-pwsh-subprocess.d.ts",
      "default": "./lib/local-pwsh-subprocess.js"
    },
    "./directory-picker": {
      "types": "./lib/directory-picker.d.ts",
      "default": "./lib/directory-picker.js"
    },
    "./workspaces": {
      "types": "./lib/workspaces.d.ts",
      "default": "./lib/workspaces.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bundle": "npm run build && node scripts/smoke-bundle.mjs",
    "test:loopback": "DSH_SSH_LOOPBACK=1 vitest run tests/loopback-ssh.test.ts",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run --cache .npm-cache"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.28.2",
    "ssh2": "^1.17.0",
    "react": "^18.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ssh",
    "remote-workspace",
    "cordis"
  ]
}
