{
  "name": "dsh-ssh-workspaces",
  "version": "0.2.1",
  "description": "Native DSH Web SSH workspaces with host plugins and skills, shared SSH execution and optional reverse tunnels",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/deploy-helper.mjs",
    "docs",
    "README.md",
    "LICENSE",
    "runtime"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir lib/types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ssh": "node --import tsx --test tests/ssh.integration.ts",
    "test:web": "node tests/web.smoke.mjs",
    "prepack": "npm run build",
    "test:install": "node --import tsx --test tests/helper.integration.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-ssh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-ssh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
